PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas URI (replace <username> and <password> with your Atlas database user credentials)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/internshiplog?retryWrites=true&w=majority

# Or for local MongoDB:
# MONGO_URI=mongodb://127.0.0.1:27017/internshiplog
